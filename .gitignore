*.py[cod]
*.pyo

# Python 가상환경
.venv/
venv/

# 개발도구 설정
.vscode/
.idea/

# 환경/비밀 설정
.env
*.env

# 로그 및 임시 파일
*.log
*.tmp
*.temp
~$*

# AI Auditor 실행 데이터
data/*
!data/.gitkeep

