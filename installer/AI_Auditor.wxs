<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="AI.Auditor"
      Name="AI Auditor"
      Version="1.0.0"
      Manufacturer="AI Auditor"
      Scope="perUserOrMachine">

    <!--
      Qwen3-4B-Q4_K_M.gguf is larger than 2 GiB.
      Keep cabinets external and split large-file cabinets below the Windows Installer limit.
    -->
    <MediaTemplate
        EmbedCab="no"
        CabinetTemplate="aia{0}.cab"
        CompressionLevel="high"
        MaximumUncompressedMediaSize="1024"
        MaximumCabinetSizeForLargeFileSplitting="1024" />

    <!--
      Install under the current user's program area so AI_Auditor.exe can create/write
      its adjacent data\ai_auditor.db without requiring Program Files write access.
    -->
    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="AI Auditor" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AI Auditor">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="AI Auditor"
              Description="AI 기반 프로젝트 품질 감사 플랫폼"
              Target="[INSTALLFOLDER]AI_Auditor.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\AI Auditor"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AI Auditor" Level="1">
      <Files Include="!(bindpath.app)\**" Directory="INSTALLFOLDER">
        <!-- The runtime-created SQLite DB must not be packaged. -->
        <Exclude Files="!(bindpath.app)\data\ai_auditor.db" />
      </Files>
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
