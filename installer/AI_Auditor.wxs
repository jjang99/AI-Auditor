<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="AI.Auditor"
      Name="AI Auditor"
      Version="1.0.0"
      Manufacturer="AI Auditor"
      Scope="perUserOrMachine">

    <!--
      Application/runtime payload is stored in external cabinets.
      The Qwen GGUF model is larger than the Windows Installer File table limit,
      so it is shipped beside the MSI and copied from SourceDir during install.
    -->
    <MediaTemplate
        EmbedCab="no"
        CabinetTemplate="aia{0}.cab"
        CompressionLevel="high" />

    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="AI Auditor">
        <Directory Id="ModelFolder" Name="models" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AI Auditor">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="AI Auditor"
              Description="AI 기반 프로젝트 품질 감사 플랫폼"
              Target="[INSTALLFOLDER]AI_Auditor.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\AI Auditor"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      The model is intentionally NOT authored as a File element. WiX rejects
      individual File-table entries >= 2 GiB (WIX0263). Instead, Windows Installer's
      MoveFiles action copies the already-present model from the MSI source folder.
    -->
    <Component Id="ExternalModelComponent" Directory="ModelFolder" Guid="*">
      <CopyFile
          Id="CopyExternalQwenModel"
          SourceProperty="SourceDir"
          SourceName="Qwen3-4B-Q4_K_M.gguf"
          DestinationDirectory="ModelFolder"
          DestinationName="Qwen3-4B-Q4_K_M.gguf" />
      <RemoveFile
          Id="RemoveExternalQwenModel"
          Name="Qwen3-4B-Q4_K_M.gguf"
          On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\AI Auditor"
          Name="modelInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="AI Auditor" Level="1">
      <Files Include="!(bindpath.app)\**" Directory="INSTALLFOLDER">
        <Exclude Files="!(bindpath.app)\data\ai_auditor.db" />
        <Exclude Files="!(bindpath.app)\models\Qwen3-4B-Q4_K_M.gguf" />
      </Files>
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ExternalModelComponent" />
    </Feature>
  </Package>
</Wix>
